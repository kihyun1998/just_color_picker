.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# From .gitignore: IntelliJ
*.iml
*.ipr
*.iws
.idea/

# From .gitignore: Flutter/Dart/Pub
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Repository docs for maintainers and agents
docs/
CLAUDE.md
